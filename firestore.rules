rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User root profile, settings, and active session
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User-specific experiences / campaigns subcollection
      match /experiences/{experienceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Legacy fallback compatibility for un-migrated root docs
    match /experiences/{experienceId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
