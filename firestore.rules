// DO NOT DEPLOY THIS FILE AS-IS. The Firebase project is shared with another app
// (MentalMedic), whose data also lives under users/{uid}. These rules only describe
// ZeroRoll's paths, so publishing them would lock that app out. The live rules are a
// single owner-only `match /users/{userId}/{document=**}` rule, which already covers
// everything ZeroRoll stores (experiences, stories, turns). Keep this file as the record
// of what ZeroRoll needs; merge any change into the live rules by hand in the console.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // User root document: profile, settings, activeExperienceId
    // Only the authenticated owner may read or write their own user doc.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // -----------------------------------------------------------------------
      // User-owned experiences subcollection.
      //
      // Security requirements enforced HERE (not client-side):
      //   • The requesting user must be authenticated.
      //   • The authenticated UID must match the parent userId path segment.
      //   • On create/update, the document's userId field must equal the
      //     authenticated UID — prevents the client from writing a forged userId.
      // -----------------------------------------------------------------------
      match /experiences/{experienceId} {
        // Read: owner only
        allow read: if request.auth != null && request.auth.uid == userId;

        // Create: owner only + payload userId must match authenticated UID
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.userId == request.auth.uid;

        // Update: owner only + payload userId must still match authenticated UID
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.userId == request.auth.uid;

        // Delete: owner only
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // -----------------------------------------------------------------------
      // Story mode cloud backups: one document per story (state, memory,
      // settings) and its turns in pages of 50 messages. Owner only.
      // -----------------------------------------------------------------------
      match /stories/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /turns/{page} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // -------------------------------------------------------------------------
    // The legacy root /experiences collection is no longer used by the
    // application. All reads and writes are denied to prevent accidental
    // or malicious access.
    // -------------------------------------------------------------------------
    match /experiences/{experienceId} {
      allow read, write: if false;
    }
  }
}
